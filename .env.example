DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_NAME=gpb_resolve
DB_USER=root
DB_PASS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sending-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_ENCRYPTION=tls
SMTP_FROM_NAME=GPB-Resolve
# Gmail normally requires this to be the authenticated account or a verified alias.
SMTP_FROM_EMAIL=your-sending-account@gmail.com

APP_BASE_URL=/GPB-Resolve

